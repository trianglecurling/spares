# Server Configuration
PORT=3001
NODE_ENV=development

# Vite's dev server default port
FRONTEND_URL=http://localhost:5173

# Server time zone (used for league schedule + same-day checks)
# Example: America/New_York
TIME_ZONE=America/New_York

# Registration: max sabbatical span from first day of play when sabbatical began.
# Extension is blocked for leagues whose final day of play is on or after this anniversary.
# See docs/registration/sabbaticals.md (Duration limit).
# TODO: make this a real config
SABBATICAL_DURATION_LIMIT_YEARS=3

# Database
# Note: Does SQLITE even work still?
DATABASE_PATH=./data/spares.sqlite

# @See backend/data/db-config.example.json

# JWT Secret (generate a long random string)
# You can generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Administrators (comma-separated email addresses)
# These users will always have admin rights
SERVER_ADMINS=your@email.com

# Azure Communication Services (for sending emails)
# Leave empty to log emails to console during development
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_COMMUNICATION_SENDER_EMAIL=donotreply@yourcurlingclub.com

# Twilio (for sending SMS)
# Leave empty to log SMS to console during development
# Note: Feature is incomplete
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OTEL
OTEL_ENABLED=false
OTEL_SERVICE_NAME=thebroomstack
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-endpoint:4431

# PAYMENT PROCESSORS
PAYMENT_ENABLED_PROVIDERS=stripe,square
PAYMENT_DEFAULT_PROVIDER=square

# Stripe
STRIPE_API_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Square
SQUARE_ENVIRONMENT=sandbox
# SANDBOX
# SQUARE_APPLICATION_ID=sandbox-sqxxxx-xxxxxxxx 
#SANDBOX
# SQUARE_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PRODUCTION
SQUARE_APPLICATION_ID=sqxxx-xxxxxxxxxxx-xxxxxxxxx 
# PRODUCTION
SQUARE_ACCESS_TOKEN=xxxxxxxxxxxxxxxx
PAYMENT_WEBHOOK_BASE_URL=https://yourcurlingclub.com
# PRODUCTION
SQUARE_LOCATION_ID=xxxxxxxxxxx
SQUARE_WEBHOOK_SECRET=xxxxxxxxxxxxxxx

# Payment reconciliation fallback for missed webhooks
# Pretty sure this doesn't work lol
PAYMENT_RECONCILE_ENABLED=true 
PAYMENT_RECONCILE_INTERVAL_MS=60000 

# try to reconcile payments in the background if they are still pending after this much time
PAYMENT_RECONCILE_STALE_AFTER_SECONDS=600 

# do not try to reconcile payments older than this time
PAYMENT_RECONCILE_MAX_PENDING_AGE_SECONDS=3600 
PAYMENT_RECONCILE_BATCH_SIZE=25 

# CleverWaiver integration
CLEVERWAIVER_APP_NAME=waiveradmin
CLEVERWAIVER_CLIENT_ID=xxxxxxxxxxxx
CLEVERWAIVER_ACCESS_TOKEN=xxxxxxxxxxxxxxx

# Mailing lists/Mautic integration
MAUTIC_BASE_URL=https://mail.yourcurlingclub.com
MAUTIC_OAUTH_CLIENT_ID=xxxxxxxxxxxxxxx
MAUTIC_OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
MAUTIC_SEGMENT_ID_BONSPIELS=3
MAUTIC_SEGMENT_ID_MEMBERSHIP=8
MAUTIC_SEGMENT_ID_LEARN_TO_CURL=5

# IP addresses to bypass certain IP limits for (e.g. club WiFi)
IP_LIMIT_BYPASS_ALLOWLIST=50.50.50.50